{
  "name": "blazma-ai",
  "productName": "Blazma AI",
  "version": "0.1.0",
  "description": "تطبيق ويندوز عربي لمحادثة ذكاء اصطناعي محلي ومراقبة الجهاز",
  "main": "src/main/main.js",
  "author": "mr-kateba",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-kateba/blazma-ai.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "diag": "node scripts/diag.js",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "build": {
    "appId": "com.blazma.ai",
    "productName": "Blazma AI",
    "files": [
      "src/**/*",
      "catalog.json",
      "package.json",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/@napi-rs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "Blazma AI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blazma AI",
      "runAfterFinish": true,
      "unicode": true,
      "language": "1025",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Blazma-AI-Setup-${version}.${ext}",
      "license": "LICENSE"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mr-kateba",
        "repo": "blazma-ai",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.3.289"
  }
}
